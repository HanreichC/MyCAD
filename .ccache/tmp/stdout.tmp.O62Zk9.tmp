template<typename... Args>
class FormatString
{
public:
    template<std::size_t N>

    consteval FormatString(const char (&literal)[N])
        : format(literal)
    {}



    constexpr FormatString(std::format_string<Args...> passed)
        : format(passed)
    {}

    constexpr operator std::format_string<Args...>() const
    {
        return format;
    }

private:
