using namespace App;
using namespace Base;
using namespace std;
using namespace SketcherGui;


Base::Type SketcherGui::PropertyVisualLayerList::getClassTypeId(void) { return SketcherGui::PropertyVisualLayerList::classTypeId; } Base::Type SketcherGui::PropertyVisualLayerList::getTypeId(void) const { return SketcherGui::PropertyVisualLayerList::classTypeId; } Base::Type SketcherGui::PropertyVisualLayerList::classTypeId = Base::Type::BadType; void* SketcherGui::PropertyVisualLayerList::create(void) { return new SketcherGui::PropertyVisualLayerList(); } void SketcherGui::PropertyVisualLayerList::init(void) { initSubclass(SketcherGui::PropertyVisualLayerList::classTypeId, "SketcherGui::PropertyVisualLayerList", "App::PropertyLists", &(SketcherGui::PropertyVisualLayerList::create)); }




PropertyVisualLayerList::PropertyVisualLayerList() = default;

PropertyVisualLayerList::~PropertyVisualLayerList() = default;




PyObject* PropertyVisualLayerList::getPyObject()
{
    Py::List layers;
    for (const auto& layer : _lValueList) {
        Py::Dict values;
        values.setItem("LinePattern", Py::Long(static_cast<unsigned long>(layer.getLinePattern())));
        values.setItem("LineWidth", Py::Float(layer.getLineWidth()));
        values.setItem("Visible", Py::Boolean(layer.isVisible()));
        layers.append(values);
    }
    return Py::new_reference_to(layers);
}

VisualLayer PropertyVisualLayerList::getPyValue(PyObject* item) const
{

    (void)item;
    Base::setupAndThrowException<Base::NotImplementedError>(("PropertyVisualLayerList has no python counterpart"), std::source_location::current());;
}

void PropertyVisualLayerList::Save(Base::Writer& writer) const
{
    writer.Stream() << writer.ind() << "<VisualLayerList count=\"" << getSize() << "\">" << endl;
    writer.incInd();
    for (int i = 0; i < getSize(); i++) {
        _lValueList[i].Save(writer);
    }
    writer.decInd();
    writer.Stream() << writer.ind() << "</VisualLayerList>" << endl;
}

void PropertyVisualLayerList::Restore(Base::XMLReader& reader)
{
    reader.readElement("VisualLayerList");

    int count = reader.getAttribute<long>("count");

    std::vector<VisualLayer> layers;
    layers.reserve(count);

    for (int i = 0; i < count; i++) {
        VisualLayer visualLayer;
        visualLayer.Restore(reader);
        layers.push_back(std::move(visualLayer));
    }

    reader.readEndElement("VisualLayerList");

    setValues(std::move(layers));
}

Property* PropertyVisualLayerList::Copy() const
{
    PropertyVisualLayerList* p = new PropertyVisualLayerList();
    p->_lValueList = _lValueList;
    return p;
}

void PropertyVisualLayerList::Paste(const Property& from)
{
    setValues(dynamic_cast<const PropertyVisualLayerList&>(from)._lValueList);
}

unsigned int PropertyVisualLayerList::getMemSize() const
{
    return static_cast<unsigned int>(_lValueList.size() * sizeof(VisualLayer));
}
