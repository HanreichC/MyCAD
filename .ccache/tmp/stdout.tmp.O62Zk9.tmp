      template <unsigned __d, typename _Tp>
      consteval auto
      __modulo_offset()
      {
 using _Up = make_unsigned_t<_Tp>;
 auto constexpr __a = _Up(-1) - _Up(255 + __d - 2);
 auto constexpr __b = _Up(__d * (__a / __d) - 1);

 return _Up(-1) - __b;
