class QObject;

class __attribute__((visibility("default"))) QBasicTimer
{
    Qt::TimerId m_id;
    QBasicTimer(const QBasicTimer &) = delete; QBasicTimer &operator=(const QBasicTimer &) = delete;

public:

    using Duration = QAbstractEventDispatcher::Duration;

    constexpr QBasicTimer() noexcept : m_id{Qt::TimerId::Invalid} {}
    ~QBasicTimer() { if (isActive()) stop(); }

    QBasicTimer(QBasicTimer &&other) noexcept
        : m_id{std::exchange(other.m_id, Qt::TimerId::Invalid)}
    {}

    QBasicTimer &operator=(QBasicTimer &&other) noexcept { QBasicTimer moved(std::move(other)); swap(moved); return *this; }

    void swap(QBasicTimer &other) noexcept { std::swap(m_id, other.m_id); }

    bool isActive() const noexcept { return m_id != Qt::TimerId::Invalid; }
    int timerId() const noexcept { return qToUnderlying(id()); }
    Qt::TimerId id() const noexcept { return m_id; }
    inline
    void start(int msec, QObject *obj);
    inline
    void start(int msec, Qt::TimerType timerType, QObject *obj);





    void start(Duration duration, QObject *obj)
    { start(duration, Qt::CoarseTimer, obj); }
    void start(Duration duration, Qt::TimerType timerType, QObject *obj);
    void stop();
};
template<> class QTypeInfo<QBasicTimer > { public: enum { isComplex = (((Q_RELOCATABLE_TYPE) & Q_PRIMITIVE_TYPE) == 0) && QtPrivate::qIsComplex<QBasicTimer>, isRelocatable = !isComplex || ((Q_RELOCATABLE_TYPE) & Q_RELOCATABLE_TYPE) || QtPrivate::qIsRelocatable<QBasicTimer>, isPointer [[deprecated("Use std::is_pointer instead")]] = std::is_pointer_v< QBasicTimer >, isIntegral [[deprecated("Use std::is_integral instead")]] = std::is_integral< QBasicTimer >::value, isValueInitializationBitwiseZero = QtPrivate::qIsValueInitializationBitwiseZero<QBasicTimer>, }; static_assert(!QTypeInfo<QBasicTimer>::isRelocatable || std::is_copy_constructible_v<QBasicTimer > || std::is_move_constructible_v<QBasicTimer >, "QBasicTimer" " is neither copy- nor move-constructible, so cannot be Q_RELOCATABLE_TYPE"); };


void QBasicTimer::start(int msec, QObject *obj)
{
    start(std::chrono::milliseconds{msec}, obj);
}

void QBasicTimer::start(int msec, Qt::TimerType t, QObject *obj)
{
    start(std::chrono::milliseconds{msec}, t, obj);
}


inline void swap(QBasicTimer &lhs, QBasicTimer &rhs) noexcept { lhs.swap(rhs); }


