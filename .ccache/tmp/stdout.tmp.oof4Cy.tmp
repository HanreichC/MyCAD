namespace Base
{


class AbstractProducer
{
public:
    AbstractProducer() = default;
    virtual ~AbstractProducer() = default;

    virtual void* Produce() const = 0;

    AbstractProducer(const AbstractProducer &) = delete; AbstractProducer &operator=(const AbstractProducer &) = delete; AbstractProducer(AbstractProducer &&) = delete; AbstractProducer &operator=(AbstractProducer &&) = delete;
};
# 57 "/workspace/src/Base/Factory.h"
class Factory
{
public:

    void AddProducer(const char* sClassName, AbstractProducer* pcProducer);

    bool CanProduce(const char* sClassName) const;

    std::list<std::string> CanProduce() const;

    virtual ~Factory();

    Factory(const Factory &) = delete; Factory &operator=(const Factory &) = delete; Factory(Factory &&) = delete; Factory &operator=(Factory &&) = delete;

protected:

    void* Produce(const char* sClassName) const;

    Factory() = default;

    std::map<const std::string, AbstractProducer*> _mpcProducers;
};





class ScriptFactorySingleton: public Factory
{
public:
    static ScriptFactorySingleton& Instance();
    static void Destruct();

    const char* ProduceScript(const char* sScriptName) const;

    ScriptFactorySingleton(const ScriptFactorySingleton &) = delete; ScriptFactorySingleton &operator=(const ScriptFactorySingleton &) = delete; ScriptFactorySingleton(ScriptFactorySingleton &&) = delete; ScriptFactorySingleton &operator=(ScriptFactorySingleton &&) = delete;

private:
    static ScriptFactorySingleton* _pcSingleton;

protected:
    ScriptFactorySingleton() = default;
    ~ScriptFactorySingleton() override = default;
};

inline ScriptFactorySingleton& ScriptFactory()
{
    return ScriptFactorySingleton::Instance();
}







class ScriptProducer: public AbstractProducer
{
public:

    ScriptProducer(const char* name, const char* script)
        : mScript(script)
    {
        ScriptFactorySingleton::Instance().AddProducer(name, this);
    }

    ~ScriptProducer() override = default;


    void* Produce() const override
    {

        return const_cast<char*>(mScript);
    }

    ScriptProducer(const ScriptProducer &) = delete; ScriptProducer &operator=(const ScriptProducer &) = delete; ScriptProducer(ScriptProducer &&) = delete; ScriptProducer &operator=(ScriptProducer &&) = delete;

private:
    const char* mScript;
};

}
