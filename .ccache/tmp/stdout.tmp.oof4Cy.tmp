template<class T>
class WeakPtrT
{
public:
    explicit WeakPtrT(T* t)
        : ptr(t)
    {}
    ~WeakPtrT() = default;





    void reset()
    {
        ptr.reset();
    }




    bool expired() const
    {
        return ptr.expired();
    }




    WeakPtrT<T>& operator=(T* p)
    {
        ptr = p;
        return *this;
    }




    T* operator*() const
    {
        return ptr.get<T>();
    }




    T* operator->() const
    {
        return ptr.get<T>();
    }




    bool operator==(const WeakPtrT<T>& p) const
    {
        return ptr == p.ptr;
    }




    bool operator!=(const WeakPtrT<T>& p) const
    {
        return ptr != p.ptr;
    }

    T* get() const noexcept
    {
        return ptr.get<T>();
    }


    WeakPtrT(const WeakPtrT&) = delete;
    WeakPtrT(WeakPtrT&&) = delete;
    WeakPtrT& operator=(const WeakPtrT&) = delete;
    WeakPtrT& operator=(WeakPtrT&&) = delete;

private:
    DocumentObjectWeakPtrT ptr;
};
