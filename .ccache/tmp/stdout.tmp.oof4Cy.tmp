    { p1.swap(p2); }


protected:
    T *d;

private:
    QScopedPointer(const QScopedPointer &) = delete; QScopedPointer &operator=(const QScopedPointer &) = delete; QScopedPointer(QScopedPointer &&) = delete; QScopedPointer &operator=(QScopedPointer &&) = delete;
};

