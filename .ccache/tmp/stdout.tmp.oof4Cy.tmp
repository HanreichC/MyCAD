template <typename T>
inline T *QSharedDataPointer<T>::clone()
{
    return new T(*this->d);
}

template <typename T>
inline T *QExplicitlySharedDataPointer<T>::clone()
{
    return new T(*this->d.get());
}

template <template <typename> class P, typename T> void
QSharedDataPointerBase<P, T>::detach_helper()
{
    T *x = clone();
    x->ref.ref();
    if (!d->ref.deref())
        destroy(d.get());
    d.reset(x);
}

