inline QSize &QSize::operator/=(qreal c)
{
    static_cast<void>(false && (!qFuzzyIsNull(c)));
    wd.setValue(QtPrivate::qSaturateRound(width() / c));
    ht.setValue(QtPrivate::qSaturateRound(height() / c));
    return *this;
}

