    {
    }

    Representation m_left;
    Representation m_top;
    Representation m_right;
    Representation m_bottom;

    friend constexpr bool comparesEqual(const QMargins &lhs, const QMargins &rhs) noexcept
    {
        return lhs.m_left == rhs.m_left
