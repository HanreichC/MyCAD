    template<typename _Fp>
      class __flipped
      {
 _Fp _M_f;

      public:
 template<typename _Tp, typename _Up>
   requires invocable<_Fp&, _Up, _Tp>
 invoke_result_t<_Fp&, _Up, _Tp>
