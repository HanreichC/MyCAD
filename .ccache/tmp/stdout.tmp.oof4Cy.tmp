template <class T>
template <typename...Args>
 auto QVLABase<T>::emplace_impl(qsizetype prealloc, void *array, const_iterator before, Args &&...args) -> iterator
{
    static_cast<void>(false && ::qt_no_assert_x(bool(isValidIterator(before)), "QVarLengthArray::insert", "The specified const_iterator argument 'before' is invalid"));
