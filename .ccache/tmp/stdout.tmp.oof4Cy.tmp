    ~QVLABaseBase() = default; QVLABaseBase(const QVLABaseBase &) = default; QVLABaseBase(QVLABaseBase &&) = default; QVLABaseBase &operator=(const QVLABaseBase &) = default; QVLABaseBase &operator=(QVLABaseBase &&) = default;

    qsizetype a;
    qsizetype s;
    void *ptr;

    inline __attribute__((always_inline)) constexpr void verify([[maybe_unused]] qsizetype pos = 0,
                                          [[maybe_unused]] qsizetype n = 1) const
    {
