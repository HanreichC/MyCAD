        static_cast<void>(false && (e > that()->begin() && e <= that()->end()));





        if (b == that()->begin() && e != that()->end()) {
            that()->ptr = e;
        } else if (e != that()->end()) {
            ::memmove(static_cast<void *>(b), static_cast<void *>(e),
