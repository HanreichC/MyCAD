 {
  if constexpr (can_use_inplace_buffer<function_proxy_impl>)
  {
   base_function_proxy* moved = new (buffer) function_proxy_impl(std::move(*this));
   this->~function_proxy_impl();
   return moved;
  }
  else
  {
   (void)buffer;
   return this;
  }
 }

private:
 callable_copy_t<Callable> m_callable;
};

