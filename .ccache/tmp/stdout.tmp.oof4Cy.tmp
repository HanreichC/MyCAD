    QMultiMap &unite(const QMultiMap &other)
    {
        if (other.isEmpty())
            return *this;

        detach();

        auto copy = other.d->m;

        copy.merge(std::move(d->m));




        d->m = std::move(copy);
        return *this;
    }

    QMultiMap &unite(QMultiMap<Key, T> &&other)
    {
        if (!other.d || other.d->m.empty())
            return *this;

        if (other.d.isShared()) {

            unite(other);
            return *this;
        }

        detach();


        other.d->m.merge(std::move(d->m));




        *this = std::move(other);
        return *this;
    }
};

template <class Key, class T> class QMultiMapIterator { typedef typename QMultiMap<Key,T>::const_iterator const_iterator; QMultiMap<Key,T> c; const_iterator i, n; inline bool item_exists() const { return n != c.constEnd(); } public: typedef const_iterator Item; inline QMultiMapIterator(const QMultiMap<Key,T> &container) : c(container), i(c.constBegin()), n(c.constEnd()) {} inline QMultiMapIterator &operator=(const QMultiMap<Key,T> &container) { c = container; i = c.constBegin(); n = c.constEnd(); return *this; } inline void toFront() { i = c.constBegin(); n = c.constEnd(); } inline void toBack() { i = c.constEnd(); n = c.constEnd(); } inline bool hasNext() const { return i != c.constEnd(); } inline Item next() { n = i++; return n; } inline Item peekNext() const { return i; } template<typename It = decltype(i), QtPrivate::IfIteratorCanMoveBackwards<It> = true> inline bool hasPrevious() const { return i != c.constBegin(); } template<typename It = decltype(i), QtPrivate::IfIteratorCanMoveBackwards<It> = true> inline Item previous() { n = --i; return n; } template<typename It = decltype(i), QtPrivate::IfIteratorCanMoveBackwards<It> = true> inline Item peekPrevious() const { const_iterator p = i; return --p; } inline const T &value() const { static_cast<void>(false && (item_exists())); return *n; } inline const Key &key() const { static_cast<void>(false && (item_exists())); return n.key(); } inline bool findNext(const T &t) { while ((n = i) != c.constEnd()) if (*i++ == t) return true; return false; } template<typename It = decltype(i), QtPrivate::IfIteratorCanMoveBackwards<It> = true> inline bool findPrevious(const T &t) { while (i != c.constBegin()) if (*(n = --i) == t) return true; n = c.constEnd(); return false; } };
template <class Key, class T> class QMutableMultiMapIterator { typedef typename QMultiMap<Key,T>::iterator iterator; typedef typename QMultiMap<Key,T>::const_iterator const_iterator; QMultiMap<Key,T> *c; iterator i, n; inline bool item_exists() const { return const_iterator(n) != c->constEnd(); } public: typedef iterator Item; inline QMutableMultiMapIterator(QMultiMap<Key,T> &container) : c(&container) { i = c->begin(); n = c->end(); } inline QMutableMultiMapIterator &operator=(QMultiMap<Key,T> &container) { c = &container; i = c->begin(); n = c->end(); return *this; } inline void toFront() { i = c->begin(); n = c->end(); } inline void toBack() { i = c->end(); n = c->end(); } inline bool hasNext() const { return const_iterator(i) != c->constEnd(); } inline Item next() { n = i++; return n; } inline Item peekNext() const { return i; } template<typename It = decltype(i), QtPrivate::IfIteratorCanMoveBackwards<It> = true> inline bool hasPrevious() const { return const_iterator(i) != c->constBegin(); } template<typename It = decltype(i), QtPrivate::IfIteratorCanMoveBackwards<It> = true> inline Item previous() { n = --i; return n; } template<typename It = decltype(i), QtPrivate::IfIteratorCanMoveBackwards<It> = true> inline Item peekPrevious() const { iterator p = i; return --p; } inline void remove() { if (const_iterator(n) != c->constEnd()) { i = c->erase(n); n = c->end(); } } inline void setValue(const T &t) { if (const_iterator(n) != c->constEnd()) *n = t; } inline T &value() { static_cast<void>(false && (item_exists())); return *n; } inline const T &value() const { static_cast<void>(false && (item_exists())); return *n; } inline const Key &key() const { static_cast<void>(false && (item_exists())); return n.key(); } inline bool findNext(const T &t) { while (const_iterator(n = i) != c->constEnd()) if (*i++ == t) return true; return false; } template<typename It = decltype(i), QtPrivate::IfIteratorCanMoveBackwards<It> = true> inline bool findPrevious(const T &t) { while (const_iterator(i) != c->constBegin()) if (*(n = --i) == t) return true; n = c->end(); return false; } };

template <typename Key, typename T>
QMultiMap<Key, T> operator+(const QMultiMap<Key, T> &lhs, const QMultiMap<Key, T> &rhs)
{
    auto result = lhs;
    result += rhs;
    return result;
}

template <typename Key, typename T>
QMultiMap<Key, T> operator+=(QMultiMap<Key, T> &lhs, const QMultiMap<Key, T> &rhs)
{
    return lhs.unite(rhs);
}

template <typename Key, typename T, typename Predicate>
qsizetype erase_if(QMultiMap<Key, T> &map, Predicate pred)
{
    return QtPrivate::associative_erase_if(map, pred);
}


