    void assign_turn_operations(cluster_info const& cluster,
        connection_map_type const& connection_map)
    {

        for (std::size_t index : cluster.turn_indices)
        {
            auto& turn = m_turns[index];
            for (int i = 0; i < 2; i++)
            {
