namespace boost { namespace geometry { namespace formula
{
# 32 "/usr/include/boost/geometry/formulas/vertex_latitude.hpp" 3
template <typename CT>
class vertex_latitude_on_sphere
{

public:
    template<typename T1, typename T2>
    static inline CT apply(T1 const& lat1,
                           T2 const& alp1)
    {

        CT const value = math::abs(cos(lat1) * sin(alp1));
        return std::acos(math::detail::bounded(value, CT(0), CT(1)));
    }
};

template <typename CT>
class vertex_latitude_on_spheroid
{

public:
# 77 "/usr/include/boost/geometry/formulas/vertex_latitude.hpp" 3
    template <typename T1, typename T2, typename Spheroid>
    static inline CT apply(T1 const& lat1,
                           T2 const& alp1,
                           Spheroid const& spheroid)
    {
        CT const f = formula::flattening<CT>(spheroid);

        CT const one_minus_f = (CT(1) - f);


        CT const bet1 = atan( one_minus_f * tan(lat1) );


        CT const betv = vertex_latitude_on_sphere<CT>::apply(bet1, alp1);


