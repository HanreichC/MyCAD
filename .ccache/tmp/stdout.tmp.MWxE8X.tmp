int qstrnicmp_impl(const char *s1, const char *s2, size_t len)
{
    if (!s1 || !s2)
        return s1 ? 1 : (s2 ? -1 : 0);
    for (; len--; ++s1, ++s2) {
        const char c = *s1;
        if (int res = QtPrivate::caseCompareAscii(c, *s2))
            return res;
        if (!c)
            break;
    }
    return 0;
}

