    math::detail::normalize_angle_loop<radian>(a_diff);
# 215 "/usr/include/boost/geometry/formulas/spherical.hpp" 3
    return math::equals(a_diff, c0)
        || math::equals(a_diff, pi)
        || math::equals(a_diff, -pi) ? 0
