    }




    discard_closed_turns
        <
            OverlayType,
            target_operation
        >::apply(turns, clusters, geometry1, geometry2, strategy);
    discard_open_turns
        <
            OverlayType,
            target_operation
        >::apply(turns, clusters, geometry1, geometry2, strategy);


