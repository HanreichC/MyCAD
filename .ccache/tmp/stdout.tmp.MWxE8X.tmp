    else if constexpr (std::is_same_v<T, Qt::partial_ordering>)
        flags = flags | QtOrderingType::Partial;
    else if constexpr (std::is_same_v<T, Qt::weak_ordering>)
        flags = flags | QtOrderingType::Weak;
    return flags;
}

