            {
                if (azimuth > c0)
                {
                    azimuth = c0;
                }
            }
            else
            {
                CT const minus_pi = -math::pi<CT>();
                if (azimuth < minus_pi)
                {
                    azimuth = minus_pi;
                }
            }
        }
    }
};

