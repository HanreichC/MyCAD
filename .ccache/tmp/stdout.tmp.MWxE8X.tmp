template<class T>
inline
typename dtl::enable_if<dtl::is_pair<T>, void >::type
   construct_type(T* p)
{
   dtl::construct_type(dtl::addressof(p->first));
   { try{
      dtl::construct_type(dtl::addressof(p->second));
   }
   catch(...) {
      typedef typename T::first_type first_type;
      dtl::addressof(p->first)->~first_type();
      throw;
   }
   }
}

