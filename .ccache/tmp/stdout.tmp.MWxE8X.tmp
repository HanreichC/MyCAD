            {
                return;
            }
        }


        if ( !interrupt_policy.is_boundary_found )
        {
            update<exterior, boundary, '1', TransposeResult>(result);
        }

        else if ( may_update<exterior, boundary, '1', TransposeResult>(result) )
        {
