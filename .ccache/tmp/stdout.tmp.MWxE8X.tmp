   inline __attribute__ ((__always_inline__)) constexpr typename std::enable_if<boost::multiprecision::detail::is_arithmetic<Arithmetic>::value, int>::type compare(Arithmetic i) const
   {

      cpp_int_backend t;
      t = i;
      return compare(t);
   }
