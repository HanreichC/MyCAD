namespace boost
{
namespace integer
{



namespace detail
{

    template < static_gcd_type Value1, static_gcd_type Value2 >
    struct static_gcd_helper_t
    {
    private:
        static const static_gcd_type new_value1 = Value2;
        static const static_gcd_type new_value2 = Value1 % Value2;
# 40 "/usr/include/boost/integer/common_factor_ct.hpp" 3
        typedef static_gcd_helper_t< static_cast<static_gcd_type>(new_value1),
         static_cast<static_gcd_type>(new_value2) > next_step_type;



    public:
        static const static_gcd_type value = next_step_type::value;
    };


    template < static_gcd_type Value1 >
    struct static_gcd_helper_t< Value1, 0UL >
    {
        static const static_gcd_type value = Value1;
    };


    template < static_gcd_type Value1, static_gcd_type Value2 >
    struct static_lcm_helper_t
    {
        typedef static_gcd_helper_t<Value1, Value2> gcd_type;

        static const static_gcd_type value = Value1 / gcd_type::value * Value2
                   ;
    };


    template < >
    struct static_lcm_helper_t< 0UL, 0UL >
    {
        static const static_gcd_type value = 0UL;
    };

}




template < static_gcd_type Value1, static_gcd_type Value2 > struct static_gcd
{
    static const static_gcd_type value = (detail::static_gcd_helper_t<Value1, Value2>::value);
};


template< static_gcd_type Value1, static_gcd_type Value2 > static_gcd_type const static_gcd< Value1, Value2 >::value;




template < static_gcd_type Value1, static_gcd_type Value2 > struct static_lcm
{
    static const static_gcd_type value = (detail::static_lcm_helper_t<Value1, Value2>::value);
};


template< static_gcd_type Value1, static_gcd_type Value2 > static_gcd_type const static_lcm< Value1, Value2 >::value;


}
