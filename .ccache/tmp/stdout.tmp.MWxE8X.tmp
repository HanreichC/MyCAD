template<class SizeType, class LimitSizeType, bool = sizeof(SizeType)<= sizeof(LimitSizeType)>
struct limit_by_stored_size_type
{
   static inline __attribute__ ((__always_inline__)) SizeType clamp(SizeType val)
   { return val; }

   static inline __attribute__ ((__always_inline__)) void set(LimitSizeType &val, SizeType v)
   { val = v; }

   template <class F>
   inline __attribute__ ((__always_inline__)) static void call_if_overflows(SizeType, F)
   {}
};

template<class SizeType, class LimitSizeType>
struct limit_by_stored_size_type<SizeType, LimitSizeType, false>
{
   static inline __attribute__ ((__always_inline__)) SizeType clamp(SizeType val)
   { return val <= LimitSizeType(-1) ? val : LimitSizeType(-1); }

   static void set(LimitSizeType &dst, SizeType val)
   {
      (static_cast<void> (0));
      dst = static_cast<LimitSizeType>(val);
   }

   template <class F>
   inline __attribute__ ((__always_inline__)) static void call_if_overflows(SizeType v, F f)
   {
      if(LimitSizeType(-1) < v)
         f();
   }
};

}
}
