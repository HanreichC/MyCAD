{
    static_assert(std::numeric_limits<T>::is_integer && !std::numeric_limits<T>::is_signed, "std::numeric_limits<T>::is_integer && !std::numeric_limits<T>::is_signed");

    static_assert(sizeof(T) <= sizeof(boost::uint64_t), "sizeof(T) <= sizeof(boost::uint64_t)");

