inline void Message_ProgressIndicator::Increment(const Standard_Real theStep,
                                                 const Message_ProgressScope& theScope)
{

  Standard_Mutex::Sentry aSentry(myMutex);

  myPosition = Min(myPosition + theStep, 1.);




  Show(theScope, false);
}
