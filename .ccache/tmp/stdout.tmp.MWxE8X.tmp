constexpr inline boost::uint32_t bit_ceil_impl( boost::uint32_t x ) noexcept
{
    if( x == 0 )
    {
        return 1;
    }

    --x;

    x |= x >> 1;
    x |= x >> 2;
    x |= x >> 4;
    x |= x >> 8;
    x |= x >> 16;

    ++x;

    return x;
}

constexpr inline boost::uint64_t bit_ceil_impl( boost::uint64_t x ) noexcept
{
    if( x == 0 )
    {
        return 1;
    }

    --x;

    x |= x >> 1;
    x |= x >> 2;
    x |= x >> 4;
    x |= x >> 8;
    x |= x >> 16;
    x |= x >> 32;

    ++x;

    return x;
}

}

