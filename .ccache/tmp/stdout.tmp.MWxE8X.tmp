inline void gp_Circ2d::Coefficients(Standard_Real& theA,
                                    Standard_Real& theB,
                                    Standard_Real& theC,
                                    Standard_Real& theD,
                                    Standard_Real& theE,
                                    Standard_Real& theF) const
{
  Standard_Real aXc = pos.Location().X();
  Standard_Real anYc = pos.Location().Y();
  theA = 1.0;
  theB = 1.0;
  theC = 0.0;
  theD = -aXc;
  theE = -anYc;
  theF = aXc * aXc + anYc * anYc - radius * radius;
}





