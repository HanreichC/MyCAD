constexpr T optimalSeed()
{
  return sizeof(T) == 8 ? static_cast<T>(14695981039346656037ULL) : static_cast<T>(2166136261U);
}
};

template <typename T1, typename T = size_t>
T hash(const T1 theValue) noexcept
{
