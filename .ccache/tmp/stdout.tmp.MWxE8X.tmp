        CT const cos_d_sigma = cos(d_sigma);

        if constexpr (CalcRevAzimuth)
        {
            result.reverse_azimuth = atan2(M, N * cos_d_sigma - sin_theta1 * sin_d_sigma);

            if (alter_result)
