      static_cast<result_type>(x), static_cast<result_type>(y), pol);
}

template <class T1, class T2, class T3, boost::math::enable_if_t<!policies::is_policy_v<T3>, bool>>
 inline tools::promote_args_t<T1, T2, T3>
   hypot(T1 x, T2 y, T3 z)
{
