template <typename Type>
class segment_ratio
{


    using floating_point_type =
        typename detail::promoted_to_floating_point<Type>::type;


    using thistype = segment_ratio<Type>;

public:
    using int_type = Type;

    inline segment_ratio()
        : m_numerator(0)
        , m_denominator(1)
        , m_approximation(0)
