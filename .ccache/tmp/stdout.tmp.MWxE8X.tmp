      for(unsigned int i = 1; i <= (n+n + 1); ++i)
      {
        d *= i;
      }
      T den = d * d * d * d * d;

      T term = num/den;
      if (n % 2 != 0)
      {
        sum -= term;
      }
      else
      {
        sum += term;
      }


      if(abs(term) < lim)
      {
         break;
      }
   }
