      return;
   case 2:
      result = x;
      return;
   default:;
   }

   const bool b_neg = eval_get_sign(x) < 0;

   T xx(x);
   if (b_neg)
      xx.negate();

   int c = xx.compare(ui_type(1));
   if (c > 0)
   {
      if constexpr(std::numeric_limits<number<T, et_on> >::has_quiet_NaN)
      {
         result = std::numeric_limits<number<T, et_on> >::quiet_NaN().backend();
         (*__errno_location ()) = 33;
      }
      else
         ::boost::throw_exception(std::domain_error("Result is undefined or complex and there is no NaN for this number type."), ::boost::source_location(::std::source_location::current()));
      return;
