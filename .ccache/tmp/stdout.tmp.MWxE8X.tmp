        CT const cos_U2 = c1 / temp_den_U2;


        CT const sin_U1 = tan_U1 * cos_U1;
        CT const sin_U2 = tan_U2 * cos_U2;
# 127 "/usr/include/boost/geometry/formulas/vincenty_inverse.hpp" 3
