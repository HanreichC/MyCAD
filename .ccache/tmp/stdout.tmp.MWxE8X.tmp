   (void* const ptr, const std::size_t size, const std::size_t alignment) noexcept
{
   (void)size;
   (void)alignment;
   if(operator_new_raw_overaligned(alignment)) {


         ::operator delete(ptr, size, std::align_val_t(alignment));






   }
   else {

      ::operator delete(ptr, size);



   }
}

template <class T>
inline __attribute__ ((__always_inline__)) T* operator_new_allocate(std::size_t count)
{
   const std::size_t max_count = std::size_t(-1)/(2*sizeof(T));
   if(__builtin_expect(count > max_count, 0))
      throw_bad_alloc();
   return static_cast<T*>(operator_new_raw_allocate(count*sizeof(T), alignment_of<T>::value));
}

template <class T>
inline __attribute__ ((__always_inline__)) void operator_delete_deallocate(T* ptr, std::size_t n) noexcept
{
   operator_delete_raw_deallocate((void*)ptr, n * sizeof(T), alignment_of<T>::value);
}


}
