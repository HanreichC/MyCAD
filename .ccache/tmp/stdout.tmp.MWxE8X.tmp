namespace
qvm_detail
    {
    template <int Dim,class Angle>
    struct
    rotx_mat_
        {
        constexpr inline __attribute__ ((always_inline))
        rotx_mat_()
            {
            }

        template <class R

            , class = typename enable_if<is_mat<R> >::type

        >
        constexpr inline __attribute__ ((always_inline))
        operator R() const
            {
            R r;
            assign(r,*this);
            return r;
            }

        private:

        rotx_mat_( rotx_mat_ const & );
        rotx_mat_ & operator=( rotx_mat_ const & );
        ~rotx_mat_();
        };

    template <int Row,int Col>
    struct
    rotx_m_get
        {
        template <class T>
        static
        constexpr inline __attribute__ ((always_inline))
        T
        get( T const & )
            {
            return scalar_traits<T>::value(Row==Col);
            }
        };

    template <>
    struct
    rotx_m_get<1,1>
        {
        template <class T>
        static
        constexpr inline __attribute__ ((always_inline))
        T
        get( T const & angle )
            {
            return cos(angle);
            }
        };

    template <>
    struct
    rotx_m_get<1,2>
        {
        template <class T>
        static
        constexpr inline __attribute__ ((always_inline))
        T
        get( T const & angle )
            {
            return -sin(angle);
            }
        };

    template <>
    struct
    rotx_m_get<2,1>
        {
        template <class T>
        static
        constexpr inline __attribute__ ((always_inline))
        T
        get( T const & angle )
            {
            return sin(angle);
            }
        };

    template <>
    struct
    rotx_m_get<2,2>
        {
        template <class T>
        static
        constexpr inline __attribute__ ((always_inline))
        T
        get( T const & angle )
            {
            return cos(angle);
            }
