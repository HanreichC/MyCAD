      if (fixed)
      {

         auto pos = str.find('.');
         if (pos != str.npos) {
            std::intmax_t l = static_cast<std::intmax_t>(pos + 1);
            l = static_cast<std::intmax_t>(digits - (static_cast<std::intmax_t>(str.size()) - l));
