   return t == 1 ? 1 : gcd(a, t);
}

template <typename Integer, typename... Args>
inline constexpr Integer lcm(Integer const &a, Integer const &b, Integer const& c, Args const&... args) noexcept(std::is_arithmetic<Integer>::value)
{
