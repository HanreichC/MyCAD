template <class T, class Policy>
 T hypot_imp(T x, T y, const Policy& pol)
{



   using std::abs; using std::acos; using std::cos; using std::fmod; using std::modf; using std::tan; using std::asin; using std::cosh; using std::frexp; using std::pow; using std::tanh; using std::atan; using std::exp; using std::ldexp; using std::sin; using std::atan2; using std::fabs; using std::log; using std::sinh; using std::ceil; using std::floor; using std::log10; using std::sqrt; using std::log2; using std::ilogb; using boost::math::round; using boost::math::iround; using boost::math::lround; using boost::math::trunc; using boost::math::itrunc; using boost::math::ltrunc; using boost::math::modf;

   x = fabs(x);
   y = fabs(y);






   if(boost::math::numeric_limits<T>::has_infinity
      && ((x == boost::math::numeric_limits<T>::infinity())
      || (y == boost::math::numeric_limits<T>::infinity())))
      return policies::raise_overflow_error<T>("boost::math::hypot<%1%>(%1%,%1%)", nullptr, pol);




   if(y > x)
      std::swap(x, y);

   if(x * tools::epsilon<T>() >= y)
      return x;

   T rat = y / x;
   return x * sqrt(1 + rat*rat);
}

template <class T, class Policy>
 T hypot_imp(T x, T y, T z, const Policy& pol)
{
   using std::abs; using std::acos; using std::cos; using std::fmod; using std::modf; using std::tan; using std::asin; using std::cosh; using std::frexp; using std::pow; using std::tanh; using std::atan; using std::exp; using std::ldexp; using std::sin; using std::atan2; using std::fabs; using std::log; using std::sinh; using std::ceil; using std::floor; using std::log10; using std::sqrt; using std::log2; using std::ilogb; using boost::math::round; using boost::math::iround; using boost::math::lround; using boost::math::trunc; using boost::math::itrunc; using boost::math::ltrunc; using boost::math::modf;

   x = fabs(x);
   y = fabs(y);
   z = fabs(z);






   if constexpr (boost::math::numeric_limits<T>::has_infinity)
   {
      if(((x == boost::math::numeric_limits<T>::infinity())
         || (y == boost::math::numeric_limits<T>::infinity())
         || (z == boost::math::numeric_limits<T>::infinity())))
         return policies::raise_overflow_error<T>("boost::math::hypot<%1%>(%1%,%1%,%1%)", nullptr, pol);
   }




   const T a {(max)((max)(x, y), z)};

   if (a == T(0))
   {
      return a;
   }

   const T x_div_a {x / a};
   const T y_div_a {y / a};
   const T z_div_a {z / a};

   return a * sqrt(x_div_a * x_div_a
                 + y_div_a * y_div_a
                 + z_div_a * z_div_a);

}

}

template <class T1, class T2>
 inline typename tools::promote_args<T1, T2>::type
   hypot(T1 x, T2 y)
{
   typedef typename tools::promote_args<T1, T2>::type result_type;
   return detail::hypot_imp(
      static_cast<result_type>(x), static_cast<result_type>(y), policies::policy<>());
}

template <class T1, class T2, class Policy, boost::math::enable_if_t<policies::is_policy_v<Policy>, bool>>
 inline typename tools::promote_args<T1, T2>::type
   hypot(T1 x, T2 y, const Policy& pol)
{
   typedef typename tools::promote_args<T1, T2>::type result_type;
