namespace boost{ namespace math{ namespace tools{




template <class T, class U>
 U evaluate_polynomial(const T* poly, U const& z, boost::math::size_t count) noexcept(std::is_floating_point<U>::value);

namespace detail{

template <class T, class V, class Tag>
 inline V evaluate_polynomial_c_imp(const T* a, const V& val, const Tag*) noexcept(std::is_floating_point<V>::value)
{
   return evaluate_polynomial(a, val, Tag::value);
}

}






template <class T, class U>
 inline U evaluate_polynomial(const T* poly, U const& z, boost::math::size_t count) noexcept(std::is_floating_point<U>::value)
{
   (static_cast<void> (0));
   U sum = static_cast<U>(poly[count - 1]);
   for(int i = static_cast<int>(count) - 2; i >= 0; --i)
   {
      sum *= z;
      sum += static_cast<U>(poly[i]);
   }
   return sum;
}




template <boost::math::size_t N, class T, class V>
 inline V evaluate_polynomial(const T(&a)[N], const V& val) noexcept(std::is_floating_point<V>::value)
{
   typedef boost::math::integral_constant<int, static_cast<int>(N)> tag_type;
   return detail::evaluate_polynomial_c_imp(static_cast<const T*>(a), val, static_cast<tag_type const*>(nullptr));
}


template <boost::math::size_t N, class T, class V>
 inline V evaluate_polynomial(const std::array<T,N>& a, const V& val) noexcept(std::is_floating_point<V>::value)
{
   typedef boost::math::integral_constant<int, static_cast<int>(N)> tag_type;
   return detail::evaluate_polynomial_c_imp(static_cast<const T*>(a.data()), val, static_cast<tag_type const*>(nullptr));
}




template <class T, class U>
 inline U evaluate_even_polynomial(const T* poly, U z, boost::math::size_t count) noexcept(std::is_floating_point<U>::value)
{
   return evaluate_polynomial(poly, U(z*z), count);
}

template <boost::math::size_t N, class T, class V>
 inline V evaluate_even_polynomial(const T(&a)[N], const V& z) noexcept(std::is_floating_point<V>::value)
{
   return evaluate_polynomial(a, V(z*z));
}


template <boost::math::size_t N, class T, class V>
 inline V evaluate_even_polynomial(const std::array<T,N>& a, const V& z) noexcept(std::is_floating_point<V>::value)
{
   return evaluate_polynomial(a, V(z*z));
}




template <class T, class U>
 inline U evaluate_odd_polynomial(const T* poly, U z, boost::math::size_t count) noexcept(std::is_floating_point<U>::value)
{
   return poly[0] + z * evaluate_polynomial(poly+1, U(z*z), count-1);
}

template <boost::math::size_t N, class T, class V>
 inline V evaluate_odd_polynomial(const T(&a)[N], const V& z) noexcept(std::is_floating_point<V>::value)
{
   typedef boost::math::integral_constant<int, static_cast<int>(N-1)> tag_type;
   return a[0] + z * detail::evaluate_polynomial_c_imp(static_cast<const T*>(a) + 1, V(z*z), static_cast<tag_type const*>(nullptr));
}


template <boost::math::size_t N, class T, class V>
 inline V evaluate_odd_polynomial(const std::array<T,N>& a, const V& z) noexcept(std::is_floating_point<V>::value)
{
   typedef boost::math::integral_constant<int, static_cast<int>(N-1)> tag_type;
   return a[0] + z * detail::evaluate_polynomial_c_imp(static_cast<const T*>(a.data()) + 1, V(z*z), static_cast<tag_type const*>(nullptr));
}


template <class T, class U, class V>
 V evaluate_rational(const T* num, const U* denom, const V& z_, boost::math::size_t count) noexcept(std::is_floating_point<V>::value);

namespace detail{

template <class T, class U, class V, class Tag>
 inline V evaluate_rational_c_imp(const T* num, const U* denom, const V& z, const Tag*) noexcept(std::is_floating_point<V>::value)
{
   return boost::math::tools::evaluate_rational(num, denom, z, Tag::value);
}

}
# 291 "/usr/include/boost/math/tools/rational.hpp" 3
template <class T, class U, class V>
 V evaluate_rational(const T* num, const U* denom, const V& z_, boost::math::size_t count) noexcept(std::is_floating_point<V>::value)
{
   V z(z_);
   V s1, s2;
   if(z <= 1)
   {
      s1 = static_cast<V>(num[count-1]);
      s2 = static_cast<V>(denom[count-1]);
      for(int i = (int)count - 2; i >= 0; --i)
      {
         s1 *= z;
         s2 *= z;
         s1 += num[i];
         s2 += denom[i];
      }
   }
   else
   {
      z = 1 / z;
      s1 = static_cast<V>(num[0]);
      s2 = static_cast<V>(denom[0]);
      for(unsigned i = 1; i < count; ++i)
      {
         s1 *= z;
         s2 *= z;
         s1 += num[i];
         s2 += denom[i];
      }
   }
   return s1 / s2;
}

template <boost::math::size_t N, class T, class U, class V>
 inline V evaluate_rational(const T(&a)[N], const U(&b)[N], const V& z) noexcept(std::is_floating_point<V>::value)
{
   return detail::evaluate_rational_c_imp(a, b, z, static_cast<const boost::math::integral_constant<int, static_cast<int>(N)>*>(nullptr));
}


template <boost::math::size_t N, class T, class U, class V>
 inline V evaluate_rational(const std::array<T,N>& a, const std::array<U,N>& b, const V& z) noexcept(std::is_floating_point<V>::value)
{
   return detail::evaluate_rational_c_imp(a.data(), b.data(), z, static_cast<boost::math::integral_constant<int, static_cast<int>(N)>*>(nullptr));
}


}
}
