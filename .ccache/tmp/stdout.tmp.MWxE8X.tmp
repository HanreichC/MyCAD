    sphere()
        : m_r(RadiusType((2.0 * 6378137.0 + 6356752.3142451793) / 3.0))
    {}

    template <std::size_t I>
    RadiusType get_radius() const
    {
        static_assert(I < 3, "Cannot get radius for dimensions >= 3.");

        return m_r;
