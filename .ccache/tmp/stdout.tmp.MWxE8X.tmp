        m_metaContainer.destroyConstIterator(begin);
        m_metaContainer.destroyConstIterator(end);
        return size;

    }

    void clear()
    {
        m_metaContainer.clear(mutableIterable());
    }

    Container metaContainer() const
    {
        return m_metaContainer;
    }
};


