  const math_Matrix& theRight) const
{
  if (Length() != theRight.RowNumber()) throw Standard_DimensionError("math_VectorBase::Multiplied() - input matrix has wrong dimensions");

                                                                        ;

  math_VectorBase Result(theRight.LowerColIndex, theRight.UpperColIndex);
