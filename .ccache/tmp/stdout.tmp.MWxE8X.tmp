    const Standard_Integer aNewIndex = Increment();
    aNode = new (this->myAllocator) IndexedMapNode(theKey1, aNewIndex, myData1[aHash]);
    myData1[aHash] = aNode;
    myData2[aNewIndex - 1] = aNode;
    return aNewIndex;
  }


  Standard_Integer Add(TheKeyType&& theKey1)
