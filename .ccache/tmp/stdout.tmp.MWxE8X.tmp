   {

      if (n >= this->size()){
         throw_out_of_range("vector::at out of range");
      }
   }

   inline bool priv_in_range(const_iterator pos) const
   {
      return (this->begin() <= pos) && (pos < this->end());
   }

   inline bool priv_in_range_or_end(const_iterator pos) const
   {
