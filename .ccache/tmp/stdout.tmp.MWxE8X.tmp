                        static_cast<const void *>(first),
                        n * sizeof(T));
        } else {
            static_cast<void>(false && (n == N(0)));
        }
    } else {
        q_uninitialized_move_if_noexcept_n(first, n, out);
        if constexpr (QTypeInfo<T>::isComplex)
            std::destroy_n(first, n);
    }
}


