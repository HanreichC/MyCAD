__attribute__((const)) constexpr size_t hash(size_t key, size_t seed) noexcept
{
    key ^= seed;
    if constexpr (sizeof(size_t) == 4) {
        key ^= key >> 16;
        key *= 0x45d9f3bU;
        key ^= key >> 16;
        key *= 0x45d9f3bU;
        key ^= key >> 16;
        return key;
    } else {
        quint64 key64 = key;
        key64 ^= key64 >> 32;
        key64 *= 0xd6e8feb86659fd93UL;
        key64 ^= key64 >> 32;
        key64 *= 0xd6e8feb86659fd93UL;
        key64 ^= key64 >> 32;
        return size_t(key64);
    }
}

