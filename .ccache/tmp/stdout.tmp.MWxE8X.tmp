        CT const c8 = 8;
        CT const c64 = 64;

        CT const sin_4sig1 = c2 * sin_2sig1 * (math::sqr(cos_sig1) - math::sqr(sin_sig1));
        CT const sin_4sig2 = c2 * sin_2sig2 * (math::sqr(cos_sig2) - math::sqr(sin_sig2));
        CT const sin_4sig_12 = sin_4sig2 - sin_4sig1;

        CT const L2 = (sin_4sig_12 - c8 * sin_2sig_12 + 12 * sig_12) / c64;

        if ((Order == 2))
