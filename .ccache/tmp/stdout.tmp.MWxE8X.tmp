template <>
struct direction_code_impl<cartesian_tag>
{
    template <typename PointSegmentA, typename PointSegmentB, typename Point2>
    static inline int apply(PointSegmentA const& segment_a, PointSegmentB const& segment_b,
                            Point2 const& point)
    {
