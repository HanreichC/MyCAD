   static_assert(std::numeric_limits<T>::is_specialized, "Type T must be specialized.");





   static const T m = std::numeric_limits<T>::denorm_min();

   return (_mm_getcsr() & (0x8000 | 0x40)) ? tools::min_value<T>() : m;



}

