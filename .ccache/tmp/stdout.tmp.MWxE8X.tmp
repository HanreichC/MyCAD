        typedef ::boost::concepts::detail::instantiate< &::boost::concepts::requirement_<void(*)(concepts::ConstPoint<point2_type>)>::failed> boost_concept_check291 __attribute__((__unused__));

        point1_type const& p1 = range_p.at(0);
        point1_type const& p2 = range_p.at(1);
