namespace detail {

template< typename SinglePassIterator >
inline constexpr typename iterator_difference< SinglePassIterator >::type
distance_impl(SinglePassIterator first, SinglePassIterator last, single_pass_traversal_tag)
{
    typename iterator_difference< SinglePassIterator >::type n = 0;
    while (first != last)
    {
        ++first;
        ++n;
    }
    return n;
}

template< typename RandomAccessIterator >
inline constexpr typename iterator_difference< RandomAccessIterator >::type
distance_impl(RandomAccessIterator first, RandomAccessIterator last, random_access_traversal_tag)
{
    return last - first;
}

}

