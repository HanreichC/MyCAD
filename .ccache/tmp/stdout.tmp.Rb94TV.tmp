}





inline void gp_Pnt::Scale(const gp_Pnt& theP, const Standard_Real theS)
{
  gp_XYZ aXYZ = theP.coord;
  aXYZ.Multiply(1.0 - theS);
  coord.Multiply(theS);
  coord.Add(aXYZ);
}





