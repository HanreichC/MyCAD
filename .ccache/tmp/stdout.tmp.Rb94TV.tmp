            return;
        }
        std::vector<TopoDS_Shape> dstShapes;
        for (auto& d : dst) {
            expand(d.getShape(), dstShapes);
        }
        insert(status, src.getShape(), dstShapes);
        if (shapeSet.insert(src.getShape()).second) {
            shapes.push_back(src);
        }
