TopoShape& TopoShape::makeElementBoolean(
    const char* maker,
    const TopoShape& shape,
    const char* op,
    double tolerance,
    ElementMapPolicy elementMapPolicy
)
{
    return makeElementBoolean(maker, std::vector<TopoShape>(1, shape), op, tolerance, elementMapPolicy);
