template<typename Range>
std::string joinFormatted(const Range& range, std::string_view sep)
{
    std::string result;
    for (const auto& element : range) {
        if (!result.empty()) {
            result += sep;
        }
        result += std::format("{}", element);
    }
    return result;
}





