TopoShape& TopoShape::makeElementSolid(const TopoShape& shape, const char* op)
{
    if (!op) {
        op = Part::OpCodes::Solid;
    }

    if (shape.isNull()) {
        do { std::stringstream ss; ss << "Null shape"; Base::setupAndThrowException<NullShapeException>((ss.str()), std::source_location::current());; } while (0);
    }


    TopoDS_CompSolid compsolid;
    int count = 0;
    for (const auto& s : shape.getSubShapes(TopAbs_COMPSOLID)) {
        ++count;
        compsolid = TopoDS::CompSolid(s);
        if (count > 1) {
            break;
        }
    }
    if (count == 0) {

        BRepBuilderAPI_MakeSolid mkSolid;
        count = 0;
        for (const auto& s : shape.getSubShapes(TopAbs_SHELL)) {
            ++count;
            mkSolid.Add(TopoDS::Shell(s));
        }

        if (count == 0) {
            do { std::stringstream ss; ss << "No shells or compsolids found in shape"; Base::setupAndThrowException<Base::CADKernelError>((ss.str()), std::source_location::current());; } while (0);
        }

        if (!mkSolid.IsDone()) {
            do { std::stringstream ss; ss << "Failed to create a solid in makeElementSolid!"; Base::setupAndThrowException<Base::CADKernelError>((ss.str()), std::source_location::current());; } while (0);
        }

        makeElementShape(mkSolid, shape, op);

        TopoDS_Solid solid = TopoDS::Solid(_Shape);
        BRepLib::OrientClosedSolid(solid);
        setShape(solid, false);
    }
    else if (count == 1) {
        BRepBuilderAPI_MakeSolid mkSolid(compsolid);
        makeElementShape(mkSolid, shape, op);
    }
    else {
        do { std::stringstream ss; ss << "Only one compsolid can be accepted. " "Provided shape has more than one compsolid."; Base::setupAndThrowException<Base::CADKernelError>((ss.str()), std::source_location::current());; } while (0)



         ;
    }
    return *this;
}

TopoShape& TopoShape::makeElementMirror(const TopoShape& shape, const gp_Ax2& ax2, const char* op)
{
    if (!op) {
        op = Part::OpCodes::Mirror;
    }

    if (shape.isNull()) {
        do { std::stringstream ss; ss << "Null shape"; Base::setupAndThrowException<NullShapeException>((ss.str()), std::source_location::current());; } while (0);
