 if constexpr (bidirectional_iterator<_Iter1> && same_as<_Iter1, _Sent1>)
   {
     _Iter1 __it1 = __last1;
     if (__n1 != -1)
       ranges::advance(__it1, -iter_difference_t<_Iter1>(__n2));
