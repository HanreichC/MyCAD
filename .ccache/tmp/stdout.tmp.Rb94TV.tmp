TopoShape& TopoShape::makeElementXor(
    const std::vector<TopoShape>& shapes,
    const char* op,
    double tol,
    ElementMapPolicy elementMapPolicy
)
{
    if (shapes.empty()) {
        do { std::stringstream ss; ss << "Null shape"; Base::setupAndThrowException<NullShapeException>((ss.str()), std::source_location::current());; } while (0);
    }

    if (Base::Sequencer().wasCanceled()) {
        do { std::stringstream ss; ss << "User aborted"; Base::setupAndThrowException<Base::CADKernelError>((ss.str()), std::source_location::current());; } while (0);
    }

    if (!op) {
        op = Part::OpCodes::Xor;
    }

    std::vector<TopoShape> expandedShapes;

    for (auto it = shapes.begin(); it != shapes.end(); ++it) {
        auto& shape = *it;
        if (shape.isNull()) {
            do { std::stringstream ss; ss << "Null input shape for XOR operation"; Base::setupAndThrowException<NullShapeException>((ss.str()), std::source_location::current());; } while (0);
        }
        if (shape.shapeType() == TopAbs_COMPOUND) {
            if (expandedShapes.empty()) {
                expandedShapes.insert(expandedShapes.end(), shapes.begin(), it);
            }
