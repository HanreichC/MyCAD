    }
    if (inputs.size() == 1) {
        *this = inputs[0];
        if (elementMapPolicy == ElementMapPolicy::Drop) {
            dropElementNaming();
        }
        if (shapes.size() == 1) {
            do { if (_s_fclvl.isEnabled(1)) { std::stringstream _str; _s_fclvl.prefix(_str, "/workspace/src/Mod/Part/App/TopoShapeExpansion.cpp", 4412) << "Boolean operation with only one shape input"; if (_s_fclvl.add_eol) _str << '\n'; Base::Console().developerWarning(std::string(), "{}", _str.str()); if (_s_fclvl.refresh) Base::Console().refresh(); } } while (0);
        }
        return *this;
    }

    TopoShape result = inputs[0];
    for (size_t i = 1; i < inputs.size(); ++i) {

        const char* currentOp = (i == inputs.size() - 1) ? op : nullptr;


        TopoShape tempUnion(0, Hasher);
        tempUnion.makeElementBoolean(
            Part::OpCodes::Fuse,
            {result, inputs[i]},
            nullptr,
            tol,
            elementMapPolicy
