# 5705 "/workspace/src/Mod/Part/App/TopoShapeExpansion.cpp" 3
                   >
# 5705 "/workspace/src/Mod/Part/App/TopoShapeExpansion.cpp"
                                     ::DownCast(gline->handle()),
                    e.Location(),
                    BRep_Tool::Tolerance(e)
                );
            }
        }
    }
    if (do_face == LinearizeFace::linearizeFaces) {
        for (auto& face : getSubTopoShapes(TopAbs_FACE)) {
