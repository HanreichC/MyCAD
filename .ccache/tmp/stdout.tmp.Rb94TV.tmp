            }
        }
    }

    auto& S1 = curves[0];
    auto& S2 = curves[1];
    bool isWire = S1.shapeType() == TopAbs_WIRE;






    S1.setTransform(S1.getTransform());
    S2.setTransform(S2.getTransform());

    if (orientation == 0) {

        
