            {
                Py::_XINCREF( p );
            }
            validate();
        }

        void release()
        {
            Py::_XDECREF( p );
            p = __null;
        }

        void validate();

    public:

        explicit Object( PyObject *pyob=Py::_None(), bool owned = false )
        : p( pyob )
        {
            if( !owned )
            {
                Py::_XINCREF( p );
            }
            validate();
        }


        Object( const Object &ob )
        : p( ob.p )
        {
            Py::_XINCREF( p );
            validate();
        }


