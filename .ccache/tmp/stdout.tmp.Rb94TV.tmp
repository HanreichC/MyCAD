    [[nodiscard]] constexpr QTaggedPointer() noexcept : d(0) {}
    [[nodiscard]] constexpr QTaggedPointer(std::nullptr_t) noexcept : QTaggedPointer() {}

    [[nodiscard]] explicit QTaggedPointer(T *pointer, Tag tag = Tag()) noexcept
