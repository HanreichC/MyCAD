namespace boost {
namespace uuids {

template<class Ch>
constexpr inline
from_chars_result<Ch> from_chars( Ch const* first, Ch const* last, uuid& u ) noexcept
{

    if( detail::is_constant_evaluated_rt() )
    {
        return detail::from_chars_generic( first, last, u );
    }
    else
    {
        return detail::from_chars_simd( first, last, u );
    }



}

}}
