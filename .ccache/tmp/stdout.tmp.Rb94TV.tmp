      std::move(__proj1), std::move(__proj2)).in2 == __last2;
 else if (__n1 < __n2)
   return false;
 else if constexpr (random_access_iterator<_Iter1>)
   return ranges::equal(__first1, __first1 + iter_difference_t<_Iter1>(__n2),
