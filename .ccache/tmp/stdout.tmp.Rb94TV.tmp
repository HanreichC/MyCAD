template<>
inline Placement convertTo<Placement, gp_Trsf>(const gp_Trsf& transform)
{
    Base::Matrix4D matrix(
        transform.Value(1, 1),
        transform.Value(1, 2),
        transform.Value(1, 3),
        transform.Value(1, 4),
        transform.Value(2, 1),
        transform.Value(2, 2),
        transform.Value(2, 3),
        transform.Value(2, 4),
        transform.Value(3, 1),
        transform.Value(3, 2),
        transform.Value(3, 3),
        transform.Value(3, 4),
        0.0,
        0.0,
        0.0,
        1.0
    );

    return Base::Placement(matrix);
}
}

