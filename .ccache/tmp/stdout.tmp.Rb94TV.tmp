TopoShape& TopoShape::makeElementRuledSurface(
    const std::vector<TopoShape>& shapes,
    int orientation,
    const char* op
)
{
    if (!op) {
        op = Part::OpCodes::RuledSurface;
    }

    if (shapes.size() != 2) {
        do { std::stringstream ss; ss << "Wrong number of input shapes"; Base::setupAndThrowException<Base::CADKernelError>((ss.str()), std::source_location::current());; } while (0);
    }

    std::vector<TopoShape> curves(2);
    int i = 0;
    for (auto& s : shapes) {
        if (s.isNull()) {
            do { std::stringstream ss; ss << "Null input shape"; Base::setupAndThrowException<NullShapeException>((ss.str()), std::source_location::current());; } while (0);
        }
        auto type = s.shapeType();
        if (type == TopAbs_WIRE || type == TopAbs_EDGE) {
            curves[i++] = s;
            continue;
        }
        auto countOfWires = s.countSubShapes(TopAbs_WIRE);
        if (countOfWires > 1) {
            curves[i++] = s.getSubTopoShape(TopAbs_WIRE, 1);
            continue;
        }
        auto countOfEdges = s.countSubShapes(TopAbs_EDGE);
        if (countOfEdges == 0) {
            do { std::stringstream ss; ss << "Input shape has no edge"; Base::setupAndThrowException<Base::CADKernelError>((ss.str()), std::source_location::current());; } while (0);
        }
        if (countOfEdges == 1) {
            curves[i++] = s.getSubTopoShape(TopAbs_EDGE, 1);
            continue;
        }
        curves[i] = s.makeElementWires();
        if (curves[i].isNull()) {
            do { std::stringstream ss; ss << "Null input shape"; Base::setupAndThrowException<NullShapeException>((ss.str()), std::source_location::current());; } while (0);
        }
        if (curves[i].shapeType() != TopAbs_WIRE) {
