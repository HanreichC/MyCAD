  Standard_Size Value(const OSD_MemInfo::Counter theCounter) const;




  Standard_Size ValueMiB(const OSD_MemInfo::Counter theCounter) const;




  Standard_Real ValuePreciseMiB(const OSD_MemInfo::Counter theCounter) const;

public:

