    return *this;
}

template< typename Block, typename AllocatorOrContainer >
constexpr typename dynamic_bitset< Block, AllocatorOrContainer >::reference &
dynamic_bitset< Block, AllocatorOrContainer >::reference::operator^=( bool x )
