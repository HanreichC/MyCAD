    return m_index.value() > 0 ? m_index.value() : -m_index.value();
  }
  inline constexpr Index rowOffset() const noexcept {
    return m_index.value() > 0 ? 0 : -m_index.value();
  }
  inline constexpr Index colOffset() const noexcept {
