}

template <typename T>
typename std::enable_if_t<std::is_enum<T>::value, QDataStream &>
operator>>(QDataStream &s, T &t)
{
    typename QIntegerForSizeof<T>::Unsigned i;
    s >> i;
    t = T(i);
    return s;
}

