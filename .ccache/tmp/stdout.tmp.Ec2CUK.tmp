    virtual DeriVector2 Value(double u, double du, const double* derivparam = nullptr) const;


    virtual int PushOwnParams(VEC_pD& pvec) = 0;


    virtual void ReconstructOnNewPvec(VEC_pD& pvec, int& cnt) = 0;


    virtual Curve* Copy() = 0;
};

