  }


  void InsertAfter(Iterator& thePosition, const TheItemType& theItem)
  {
    PInsertAfter(thePosition, new (this->myAllocator) Node(theItem));
  }


  void InsertAfter(Iterator& thePosition, TheItemType&& theItem)
  {
