template <typename Mutex>
class QMutexLocker
{




    static constexpr bool LockIsNoexcept = noexcept(std::declval<Mutex>().lock());

public:
    [[nodiscard]]
    inline explicit QMutexLocker(Mutex *mutex) noexcept(LockIsNoexcept)
    {
        m_mutex = mutex;
        if (__builtin_expect(!!(mutex), true)) {
            mutex->lock();
            m_isLocked = true;
        }
    }

    [[nodiscard]]
    inline QMutexLocker(QMutexLocker &&other) noexcept
        : m_mutex(std::exchange(other.m_mutex, nullptr)),
          m_isLocked(std::exchange(other.m_isLocked, false))
    {}

    QMutexLocker &operator=(QMutexLocker &&other) noexcept { QMutexLocker moved(std::move(other)); swap(moved); return *this; }

    inline ~QMutexLocker()
    {
        if (m_isLocked)
            unlock();
    }

    inline bool isLocked() const noexcept
    {
        return m_isLocked;
    }

    inline void unlock() noexcept
    {
        static_cast<void>(false && (m_isLocked));
        m_mutex->unlock();
        m_isLocked = false;
    }

    inline void relock() noexcept(LockIsNoexcept)
    {
        static_cast<void>(false && (!m_isLocked));
        m_mutex->lock();
        m_isLocked = true;
    }

    inline void swap(QMutexLocker &other) noexcept
    {
        qt_ptr_swap(m_mutex, other.m_mutex);
        std::swap(m_isLocked, other.m_isLocked);
    }

    Mutex *mutex() const
    {
        return m_mutex;
    }
private:
    QMutexLocker(const QMutexLocker &) = delete; QMutexLocker &operator=(const QMutexLocker &) = delete;

    Mutex *m_mutex;
    bool m_isLocked = false;
};
