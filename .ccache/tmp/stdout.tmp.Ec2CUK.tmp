  return ua == 0 ? 0 : (ua - 1) / ub + 1;
}



template <typename T, typename U>
 __attribute__((always_inline)) inline constexpr T round_down(T a, U b) {
  using UnsignedT = typename internal::make_unsigned<T>::type;
  using UnsignedU = typename internal::make_unsigned<U>::type;
  static_assert((NumTraits<T>::IsInteger), "THIS FUNCTION IS FOR INTEGER TYPES");
  static_assert((NumTraits<U>::IsInteger), "THIS FUNCTION IS FOR INTEGER TYPES");

  const UnsignedT ua = UnsignedT(a);
  const UnsignedU ub = UnsignedU(b);
  return ub * (ua / ub);
}



