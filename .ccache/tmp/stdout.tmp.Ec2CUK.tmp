    template <typename X> friend bool operator==(QPointer const &lhs, X* const &rhs) noexcept(true) { constexpr auto f = []() noexcept(true) {}; static_assert(!noexcept(f()) || noexcept(comparesEqual(lhs, rhs)), "Use *_NON_NOEXCEPT version of the macro, " "or make the helper function noexcept"); return comparesEqual(lhs, rhs); }

    friend bool comparesEqual(const QPointer &lhs, std::nullptr_t) noexcept
    { return lhs.isNull(); }
    friend bool operator==(QPointer const &lhs, std::nullptr_t const &rhs) noexcept(true) { constexpr auto f = []() noexcept(true) {}; static_assert(!noexcept(f()) || noexcept(comparesEqual(lhs, rhs)), "Use *_NON_NOEXCEPT version of the macro, " "or make the helper function noexcept"); return comparesEqual(lhs, rhs); }
