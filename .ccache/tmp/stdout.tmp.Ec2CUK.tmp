struct peven_mask_impl {
  static inline Packet run(const Packet&) {
    typedef typename unpacket_traits<Packet>::type Scalar;
    const size_t n = unpacket_traits<Packet>::size;
    alignas(sizeof(Packet)) Scalar elements[n];
