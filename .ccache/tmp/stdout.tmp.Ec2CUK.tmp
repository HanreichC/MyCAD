  constexpr Index cols() const noexcept { return Xpr::IsRowMajor ? 2 * m_xpr.cols() : m_xpr.cols(); }
  constexpr Index size() const noexcept { return 2 * m_xpr.size(); }
  constexpr Index innerStride() const noexcept { return m_xpr.innerStride(); }
  constexpr Index outerStride() const noexcept { return 2 * m_xpr.outerStride(); }
  void resize(Index rows, Index cols) {
