namespace boost {
namespace uuids {
namespace detail {

template<class T, class U> T numeric_cast( U u )
{
    static_assert(std::is_integral<T>::value, "std::is_integral<T>::value");
    static_assert(std::is_unsigned<T>::value, "std::is_unsigned<T>::value");

    static_assert(std::is_integral<U>::value, "std::is_integral<U>::value");
    static_assert(std::is_unsigned<U>::value, "std::is_unsigned<U>::value");

    if( u > std::numeric_limits<T>::max() )
    {
        ::boost::throw_exception(std::range_error( "Argument to numeric_cast is out of range of destination type" ), ::boost::source_location(::std::source_location::current()));
    }

    return static_cast<T>( u );
}

}
