inline typename boost::iterators::detail::postfix_increment_result< I, V, R, TC >::type
operator++(iterator_facade< I, V, TC, R, D >& i, int)
{
    typename boost::iterators::detail::postfix_increment_result< I, V, R, TC >::type
        tmp(*static_cast< I* >(&i));

    ++i;

    return tmp;
}
