    void eraseLast() noexcept
    {
        static_cast<void>(false && (that()->isMutable()));
        static_cast<void>(false && (that()->size));
        --that()->size;
    }

    template <typename Predicate>
    qsizetype eraseIf(Predicate pred)
    {
        qsizetype result = 0;
        if (that()->size == 0)
            return result;

        if (!that()->needsDetach()) {
            auto end = that()->end();
            auto it = std::remove_if(that()->begin(), end, pred);
            if (it != end) {
                result = std::distance(it, end);
                erase(it, result);
            }
        } else {
