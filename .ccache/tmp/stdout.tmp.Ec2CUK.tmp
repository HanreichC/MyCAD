template <typename Visitor>
 void DenseBase<Derived>::visit(Visitor& visitor) const {
  using impl = internal::visit_impl<Derived, Visitor, false>;
  impl::run(derived(), visitor);
}

namespace internal {

template <typename Scalar>
struct all_visitor {
  using result_type = bool;
  using Packet = typename packet_traits<Scalar>::type;
  inline void init(const Scalar& value, Index, Index) { res = (value != Scalar(0)); }
  inline void init(const Scalar& value, Index) { res = (value != Scalar(0)); }
  inline bool all_predux(const Packet& p) const { return !predux_any(pcmp_eq(p, pzero(p))); }
  inline void initpacket(const Packet& p, Index, Index) { res = all_predux(p); }
  inline void initpacket(const Packet& p, Index) { res = all_predux(p); }
  inline void operator()(const Scalar& value, Index, Index) { res = res && (value != Scalar(0)); }
  inline void operator()(const Scalar& value, Index) { res = res && (value != Scalar(0)); }
  inline void packet(const Packet& p, Index, Index) { res = res && all_predux(p); }
  inline void packet(const Packet& p, Index) { res = res && all_predux(p); }
  inline bool done() const { return !res; }
  bool res = true;
};
template <typename Scalar>
struct functor_traits<all_visitor<Scalar>> {
  enum { Cost = NumTraits<Scalar>::ReadCost, LinearAccess = true, PacketAccess = packet_traits<Scalar>::HasCmp };
};

template <typename Scalar>
struct any_visitor {
  using result_type = bool;
  using Packet = typename packet_traits<Scalar>::type;
  inline void init(const Scalar& value, Index, Index) { res = (value != Scalar(0)); }
  inline void init(const Scalar& value, Index) { res = (value != Scalar(0)); }
  inline bool any_predux(const Packet& p) const {
    return predux_any(pandnot(ptrue(p), pcmp_eq(p, pzero(p))));
  }
  inline void initpacket(const Packet& p, Index, Index) { res = any_predux(p); }
  inline void initpacket(const Packet& p, Index) { res = any_predux(p); }
  inline void operator()(const Scalar& value, Index, Index) { res = res || (value != Scalar(0)); }
  inline void operator()(const Scalar& value, Index) { res = res || (value != Scalar(0)); }
  inline void packet(const Packet& p, Index, Index) { res = res || any_predux(p); }
  inline void packet(const Packet& p, Index) { res = res || any_predux(p); }
  inline bool done() const { return res; }
  bool res = false;
};
template <typename Scalar>
struct functor_traits<any_visitor<Scalar>> {
  enum { Cost = NumTraits<Scalar>::ReadCost, LinearAccess = true, PacketAccess = packet_traits<Scalar>::HasCmp };
};

template <typename Scalar>
struct count_visitor {
  using result_type = Index;
  using Packet = typename packet_traits<Scalar>::type;
  inline void init(const Scalar& value, Index, Index) { res = value != Scalar(0) ? 1 : 0; }
  inline void init(const Scalar& value, Index) { res = value != Scalar(0) ? 1 : 0; }
  inline Index count_redux(const Packet& p) const {
    const Packet cst_one = pset1<Packet>(Scalar(1));
    Packet true_vals = pandnot(cst_one, pcmp_eq(p, pzero(p)));
    Scalar num_true = predux(true_vals);
    return static_cast<Index>(num_true);
  }
  inline void initpacket(const Packet& p, Index, Index) { res = count_redux(p); }
  inline void initpacket(const Packet& p, Index) { res = count_redux(p); }
  inline void operator()(const Scalar& value, Index, Index) {
    if (value != Scalar(0)) res++;
  }
  inline void operator()(const Scalar& value, Index) {
    if (value != Scalar(0)) res++;
  }
  inline void packet(const Packet& p, Index, Index) { res += count_redux(p); }
  inline void packet(const Packet& p, Index) { res += count_redux(p); }
  Index res = 0;
};

template <typename Scalar>
struct functor_traits<count_visitor<Scalar>> {
  enum {
    Cost = NumTraits<Scalar>::AddCost,
    LinearAccess = true,

    PacketAccess = packet_traits<Scalar>::HasCmp && packet_traits<Scalar>::HasAdd && !is_same<Scalar, bool>::value
  };
};

template <typename Derived, bool AlwaysTrue = NumTraits<typename traits<Derived>::Scalar>::IsInteger>
struct all_finite_impl {
  static inline bool run(const Derived& ) { return true; }
};

template <typename Derived>
struct all_finite_impl<Derived, false> {
  static inline bool run(const Derived& derived) { return derived.array().isFiniteTyped().all(); }
};


}
