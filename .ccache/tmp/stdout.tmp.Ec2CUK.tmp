    __attribute__((visibility("default"))) ~QEventLoopLocker();

    [[nodiscard]] QEventLoopLocker(QEventLoopLocker &&other) noexcept
        : p{std::exchange(other.p, quintptr(0))} {}
    QEventLoopLocker &operator=(QEventLoopLocker &&other) noexcept { QEventLoopLocker moved(std::move(other)); swap(moved); return *this; }

    void swap(QEventLoopLocker &other) noexcept { std::swap(p, other.p); }
    friend void swap(QEventLoopLocker &lhs, QEventLoopLocker &rhs) noexcept { lhs.swap(rhs); }

private:
    QEventLoopLocker(const QEventLoopLocker &) = delete; QEventLoopLocker &operator=(const QEventLoopLocker &) = delete;
    friend class QEventLoopLockerPrivate;





    enum class Type : quintptr {
        EventLoop,
        Thread,
        Application,
    };
