    template <class K, class T, class H, class P, class A>
    float unordered_map<K, T, H, P, A>::load_factor() const noexcept
    {
      if (table_.size_ == 0) {
        return 0.0f;
      }

      (static_cast<void> (0));
      return static_cast<float>(table_.size_) /
             static_cast<float>(table_.bucket_count());
    }

