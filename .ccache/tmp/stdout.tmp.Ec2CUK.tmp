};

template <typename Scalar>
struct sign_impl<Scalar, false, false> {
  static inline Scalar run(const Scalar& a) {
    return (isnan_impl<Scalar>)(a) ? a : Scalar((a > Scalar(0)) - (a < Scalar(0)));
  }
