    void moveLocal(size_t from, size_t to) noexcept
    {
        static_cast<void>(false && (offsets[from] != SpanConstants::UnusedEntry));
        static_cast<void>(false && (offsets[to] == SpanConstants::UnusedEntry));
        offsets[to] = offsets[from];
        offsets[from] = SpanConstants::UnusedEntry;
