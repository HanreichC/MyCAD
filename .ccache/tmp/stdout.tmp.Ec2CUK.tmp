    case QContainerImplHelper::Null:
    case QContainerImplHelper::Empty:
        return QList();
    case QContainerImplHelper::Full:
        return *this;
    case QContainerImplHelper::Subset:
        break;
    }


    DataPointer copied(l);
    copied->copyAppend(data() + p, data() + p + l);
    return copied;
}

