inline void
  gp_Mat::Transpose()
{
  Standard_Real aTemp;
  aTemp = myMat[0][1];
  myMat[0][1] = myMat[1][0];
  myMat[1][0] = aTemp;
  aTemp = myMat[0][2];
  myMat[0][2] = myMat[2][0];
  myMat[2][0] = aTemp;
  aTemp = myMat[1][2];
  myMat[1][2] = myMat[2][1];
  myMat[2][1] = aTemp;
}





