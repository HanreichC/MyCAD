namespace boost {
namespace uuids {
namespace detail {

__attribute__ ((__noreturn__)) inline void throw_invalid_uuid( std::ptrdiff_t pos, from_chars_error err, boost::source_location const& loc = ::boost::source_location(::std::source_location::current()) )
{
    boost::throw_exception( invalid_uuid( pos, err ), loc );
}

