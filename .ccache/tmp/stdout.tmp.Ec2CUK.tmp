    mySize = theOther.mySize;

    theOther.myFirstItem = nullptr;
    theOther.myLastItem = nullptr;
    theOther.myCurrentItem = nullptr;
    theOther.myCurrentIndex = 0;
    theOther.mySize = 0;
    return *this;
