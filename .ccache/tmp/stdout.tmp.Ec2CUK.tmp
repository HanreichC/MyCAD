  template <typename... Tags, typename... Types>
  static constexpr Index eval_at_compile_time_impl(const SymbolValue<Tags, Types>&...) {
    constexpr Index v0 = Arg0::eval_at_compile_time_impl(SymbolValue<Tags, Types>{}...);
