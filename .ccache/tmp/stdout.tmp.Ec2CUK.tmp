inline void gp_XY::Multiply(const gp_Mat2d& theMatrix)
{
  Standard_Real aXresult = theMatrix.Value(1, 1) * x + theMatrix.Value(1, 2) * y;
  y = theMatrix.Value(2, 1) * x + theMatrix.Value(2, 2) * y;
  x = aXresult;
