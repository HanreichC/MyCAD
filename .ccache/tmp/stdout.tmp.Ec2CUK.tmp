  {
    InsertAfter(theIndex - 1, theItem);
  }


  void InsertBefore(const Standard_Integer theIndex, TheItemType&& theItem)
  {
    InsertAfter(theIndex - 1, theItem);
  }


  void InsertBefore(const Standard_Integer theIndex, NCollection_Sequence& theSeq)
  {
