class QVLABaseBase
{
protected:
    QVLABaseBase() = default;
    ~QVLABaseBase() = default; QVLABaseBase(const QVLABaseBase &) = default; QVLABaseBase(QVLABaseBase &&) = default; QVLABaseBase &operator=(const QVLABaseBase &) = default; QVLABaseBase &operator=(QVLABaseBase &&) = default;

    qsizetype a;
    qsizetype s;
    void *ptr;

    inline __attribute__((always_inline)) constexpr void verify([[maybe_unused]] qsizetype pos = 0,
                                          [[maybe_unused]] qsizetype n = 1) const
    {
        static_cast<void>(false && (pos >= 0));
        static_cast<void>(false && (pos <= size()));
        static_cast<void>(false && (n >= 0));
        static_cast<void>(false && (n <= size() - pos));
    }

    struct free_deleter {
        void operator()(void *p) const noexcept { free(p); }
    };
    using malloced_ptr = std::unique_ptr<void, free_deleter>;

public:
    using size_type = qsizetype;

    constexpr size_type capacity() const noexcept { return a; }
    constexpr size_type size() const noexcept { return s; }
    constexpr bool empty() const noexcept { return size() == 0; }
};

