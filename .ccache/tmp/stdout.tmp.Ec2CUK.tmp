        key64 ^= key64 >> 32;
        key64 *= 0xd6e8feb86659fd93UL;
        key64 ^= key64 >> 32;
        key64 *= 0xd6e8feb86659fd93UL;
        key64 ^= key64 >> 32;
        return size_t(key64);
    }
}

