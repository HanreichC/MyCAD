  virtual void Clear(const opencascade::handle<NCollection_BaseAllocator>& aNewAlloc = 0L)

  {
    if (myRoot)
    {
      TreeNode::delNode(myRoot, this->myAlloc);
      this->myAlloc->Free(myRoot);
