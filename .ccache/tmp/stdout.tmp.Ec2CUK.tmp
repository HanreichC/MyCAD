  perm.resize(n + 1);
  t = cnz + cnz / 5 + 2 * n;
  C.resizeNonZeros(t);


  Eigen::internal::check_size_for_overflow<StorageIndex>(8 * (n + 1)); StorageIndex* W = (0) != 0 ? (0) : reinterpret_cast<StorageIndex*>((sizeof(StorageIndex) * (8 * (n + 1)) <= 131072) ? __builtin_alloca_with_align(sizeof(StorageIndex) * (8 * (n + 1)), 8* 16) : Eigen::internal::aligned_malloc(sizeof(StorageIndex) * (8 * (n + 1)))); Eigen::internal::aligned_stack_memory_handler<StorageIndex> W_stack_memory_destructor( (0) == 0 ? W : 0, 8 * (n + 1), sizeof(StorageIndex) * (8 * (n + 1)) > 131072);
  StorageIndex* len = W;
