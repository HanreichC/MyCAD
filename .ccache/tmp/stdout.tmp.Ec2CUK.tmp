template <class T>
template<int N>
inline T constant_reciprocal_fibonacci<T>::compute()
{



  T x0 = 1;
  T x1 = 1;
  T sum = 2;
  T diff = 1;
  while (diff > std::numeric_limits<T>::epsilon()) {
    T tmp = x1 + x0;
    diff = 1/tmp;
    sum += diff;
    x0 = x1;
    x1 = tmp;
  }
  return sum;
}

template <class T>
