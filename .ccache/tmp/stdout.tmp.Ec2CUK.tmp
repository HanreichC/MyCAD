template <typename T>
class QScopedValueRollback
{
public:
    [[nodiscard]]
    explicit constexpr QScopedValueRollback(T &var)
        : varRef(var), oldValue(var)
    {
    }

    [[nodiscard]]
    explicit constexpr QScopedValueRollback(T &var, T value)
        : varRef(var), oldValue(q20::exchange(var, std::move(value)))
    {
    }

    constexpr
    ~QScopedValueRollback()
    {
        varRef = std::move(oldValue);
    }

    constexpr void commit()
    {
        oldValue = varRef;
    }

private:
    T &varRef;
    T oldValue;

    QScopedValueRollback(const QScopedValueRollback &) = delete; QScopedValueRollback &operator=(const QScopedValueRollback &) = delete; QScopedValueRollback(QScopedValueRollback &&) = delete; QScopedValueRollback &operator=(QScopedValueRollback &&) = delete;
};


