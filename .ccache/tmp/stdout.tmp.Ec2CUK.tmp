namespace Eigen {
namespace numext {

template <>
 __attribute__((always_inline)) inline bool(isnan)(const Eigen::bfloat16& h) {
  return (bfloat16_impl::isnan)(h);
}

template <>
 __attribute__((always_inline)) inline bool(isinf)(const Eigen::bfloat16& h) {
  return (bfloat16_impl::isinf)(h);
}

template <>
 __attribute__((always_inline)) inline bool(isfinite)(const Eigen::bfloat16& h) {
  return (bfloat16_impl::isfinite)(h);
}

template <>
inline Eigen::bfloat16 bit_cast<Eigen::bfloat16, uint16_t>(const uint16_t& src) {
  return Eigen::bfloat16_impl::raw_uint16_to_bfloat16(src);
}

template <>
inline uint16_t bit_cast<uint16_t, Eigen::bfloat16>(const Eigen::bfloat16& src) {
  return Eigen::bfloat16_impl::raw_bfloat16_as_uint16(src);
}

inline bfloat16 nextafter(const bfloat16& from, const bfloat16& to) {
  if (numext::isnan (from)) {
    return from;
  }
  if (numext::isnan (to)) {
    return to;
  }
  if (from == to) {
    return to;
  }
  uint16_t from_bits = numext::bit_cast<uint16_t>(from);
  bool from_sign = from_bits >> 15;

  bool toward_inf = (to > from) == !from_sign;
  if (toward_inf) {
    ++from_bits;
  } else if ((from_bits & 0x7fff) == 0) {

    from_bits ^= 0x8000;
  } else {
    --from_bits;
  }
  return numext::bit_cast<bfloat16>(from_bits);
}


template<>
inline Eigen::bfloat16 madd<Eigen::bfloat16>(const Eigen::bfloat16& x, const Eigen::bfloat16& y, const Eigen::bfloat16& z) {
  return Eigen::bfloat16(static_cast<float>(x) * static_cast<float>(y) + static_cast<float>(z));
}

}
