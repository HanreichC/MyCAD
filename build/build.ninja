#############################################
# Utility command for test

build src/App/CMakeFiles/test.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/src/App && /usr/sbin/ctest
  DESC = Running tests...
  pool = console
  restat = 1

build src/App/test: phony src/App/CMakeFiles/test.util


#############################################
# Utility command for edit_cache

build src/App/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/src/App && /usr/sbin/ccmake -S/workspace -B/workspace/build
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build src/App/edit_cache: phony src/App/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build src/App/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/src/App && /usr/sbin/cmake --regenerate-during-build -S/workspace -B/workspace/build
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build src/App/rebuild_cache: phony src/App/CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build src/App/list_install_components: phony


#############################################
# Utility command for install

build src/App/CMakeFiles/install.util: CUSTOM_COMMAND src/App/all
  COMMAND = cd /workspace/build/src/App && /usr/sbin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build src/App/install: phony src/App/CMakeFiles/install.util


#############################################
# Utility command for install/local

build src/App/CMakeFiles/install/local.util: CUSTOM_COMMAND src/App/all
  COMMAND = cd /workspace/build/src/App && /usr/sbin/cmake -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake
  DESC = Installing only the local directory...
  pool = console
  restat = 1

build src/App/install/local: phony src/App/CMakeFiles/install/local.util


#############################################
# Utility command for install/strip

build src/App/CMakeFiles/install/strip.util: CUSTOM_COMMAND src/App/all
  COMMAND = cd /workspace/build/src/App && /usr/sbin/cmake -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake
  DESC = Installing the project stripped...
  pool = console
  restat = 1

build src/App/install/strip: phony src/App/CMakeFiles/install/strip.util


