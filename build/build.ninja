#############################################
# Utility command for test

build src/Mod/Part/App/CMakeFiles/test.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/src/Mod/Part/App && /usr/sbin/ctest
  DESC = Running tests...
  pool = console
  restat = 1

build src/Mod/Part/App/test: phony src/Mod/Part/App/CMakeFiles/test.util


#############################################
# Utility command for edit_cache

build src/Mod/Part/App/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/src/Mod/Part/App && /usr/sbin/ccmake -S/workspace -B/workspace/build
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build src/Mod/Part/App/edit_cache: phony src/Mod/Part/App/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build src/Mod/Part/App/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/src/Mod/Part/App && /usr/sbin/cmake --regenerate-during-build -S/workspace -B/workspace/build
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build src/Mod/Part/App/rebuild_cache: phony src/Mod/Part/App/CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build src/Mod/Part/App/list_install_components: phony


#############################################
# Utility command for install

build src/Mod/Part/App/CMakeFiles/install.util: CUSTOM_COMMAND src/Mod/Part/App/all
  COMMAND = cd /workspace/build/src/Mod/Part/App && /usr/sbin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build src/Mod/Part/App/install: phony src/Mod/Part/App/CMakeFiles/install.util


#############################################
# Utility command for install/local

build src/Mod/Part/App/CMakeFiles/install/local.util: CUSTOM_COMMAND src/Mod/Part/App/all
  COMMAND = cd /workspace/build/src/Mod/Part/App && /usr/sbin/cmake -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake
  DESC = Installing only the local directory...
