#############################################
# Utility command for FreeCADGui_Resources

build src/Gui/FreeCADGui_Resources: phony Ext/freecad/gui/RemoteDebugger.ui Ext/freecad/gui/RemoteDebugger.py share/3Dconnexion/3DConnexion.xml


#############################################
# Utility command for test

build src/Gui/CMakeFiles/test.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/src/Gui && /usr/sbin/ctest
  DESC = Running tests...
  pool = console
  restat = 1

build src/Gui/test: phony src/Gui/CMakeFiles/test.util


#############################################
# Utility command for edit_cache

build src/Gui/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/src/Gui && /usr/sbin/ccmake -S/workspace -B/workspace/build
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build src/Gui/edit_cache: phony src/Gui/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build src/Gui/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/src/Gui && /usr/sbin/cmake --regenerate-during-build -S/workspace -B/workspace/build
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build src/Gui/rebuild_cache: phony src/Gui/CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build src/Gui/list_install_components: phony


#############################################
# Utility command for install

build src/Gui/CMakeFiles/install.util: CUSTOM_COMMAND src/Gui/all
  COMMAND = cd /workspace/build/src/Gui && /usr/sbin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build src/Gui/install: phony src/Gui/CMakeFiles/install.util


#############################################
# Utility command for install/local

build src/Gui/CMakeFiles/install/local.util: CUSTOM_COMMAND src/Gui/all
  COMMAND = cd /workspace/build/src/Gui && /usr/sbin/cmake -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake
  DESC = Installing only the local directory...
  pool = console
  restat = 1

build src/Gui/install/local: phony src/Gui/CMakeFiles/install/local.util


#############################################
# Utility command for install/strip

build src/Gui/CMakeFiles/install/strip.util: CUSTOM_COMMAND src/Gui/all
  COMMAND = cd /workspace/build/src/Gui && /usr/sbin/cmake -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake
  DESC = Installing the project stripped...
  pool = console
  restat = 1

build src/Gui/install/strip: phony src/Gui/CMakeFiles/install/strip.util


