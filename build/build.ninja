#############################################
# Utility command for test

build src/Gui/Stylesheets/CMakeFiles/test.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/src/Gui/Stylesheets && /usr/sbin/ctest
  DESC = Running tests...
  pool = console
  restat = 1

build src/Gui/Stylesheets/test: phony src/Gui/Stylesheets/CMakeFiles/test.util


#############################################
# Utility command for edit_cache

build src/Gui/Stylesheets/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/src/Gui/Stylesheets && /usr/sbin/ccmake -S/workspace -B/workspace/build
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build src/Gui/Stylesheets/edit_cache: phony src/Gui/Stylesheets/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build src/Gui/Stylesheets/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/src/Gui/Stylesheets && /usr/sbin/cmake --regenerate-during-build -S/workspace -B/workspace/build
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build src/Gui/Stylesheets/rebuild_cache: phony src/Gui/Stylesheets/CMakeFiles/rebuild_cache.util


