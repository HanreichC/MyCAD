# Utility command for list_install_components

build src/Gui/Stylesheets/list_install_components: phony


#############################################
# Utility command for install

build src/Gui/Stylesheets/CMakeFiles/install.util: CUSTOM_COMMAND src/Gui/Stylesheets/all
  COMMAND = cd /workspace/build/src/Gui/Stylesheets && /usr/sbin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build src/Gui/Stylesheets/install: phony src/Gui/Stylesheets/CMakeFiles/install.util


#############################################
# Utility command for install/local

build src/Gui/Stylesheets/CMakeFiles/install/local.util: CUSTOM_COMMAND src/Gui/Stylesheets/all
  COMMAND = cd /workspace/build/src/Gui/Stylesheets && /usr/sbin/cmake -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake
  DESC = Installing only the local directory...
  pool = console
  restat = 1

build src/Gui/Stylesheets/install/local: phony src/Gui/Stylesheets/CMakeFiles/install/local.util


