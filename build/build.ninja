build src/Main/CMakeFiles/FreeCADGuiPy_autogen | ${cmake_ninja_workdir}src/Main/CMakeFiles/FreeCADGuiPy_autogen: phony src/Main/FreeCADGuiPy_autogen/timestamp || lib/libFreeCADApp.so lib/libFreeCADBase.so lib/libFreeCADGui.so src/3rdParty/FastSignals/libfastsignals/libfastsignals_autogen src/3rdParty/FastSignals/libfastsignals/libfastsignals_autogen_timestamp_deps src/3rdParty/FastSignals/libfastsignals/liblibfastsignals.a src/App/FreeCADApp_autogen src/App/FreeCADApp_autogen_timestamp_deps src/Base/FreeCADBase_autogen src/Base/FreeCADBase_autogen_timestamp_deps src/Build/fc_version src/Gui/FreeCADGui_autogen src/Gui/FreeCADGui_autogen_timestamp_deps src/Main/FreeCADGuiPy_autogen_timestamp_deps

# =============================================================================
# Write statements declared in CMakeLists.txt:
# /workspace/src/CMakeLists.txt
# =============================================================================


#############################################
# Utility command for test

build src/Mod/CMakeFiles/test.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/src/Mod && /usr/sbin/ctest
  DESC = Running tests...
  pool = console
  restat = 1

build src/Mod/test: phony src/Mod/CMakeFiles/test.util


#############################################
# Utility command for edit_cache

build src/Mod/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/src/Mod && /usr/sbin/ccmake -S/workspace -B/workspace/build
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build src/Mod/edit_cache: phony src/Mod/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build src/Mod/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/src/Mod && /usr/sbin/cmake --regenerate-during-build -S/workspace -B/workspace/build
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build src/Mod/rebuild_cache: phony src/Mod/CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build src/Mod/list_install_components: phony


#############################################
# Utility command for install

build src/Mod/CMakeFiles/install.util: CUSTOM_COMMAND src/Mod/all
  COMMAND = cd /workspace/build/src/Mod && /usr/sbin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build src/Mod/install: phony src/Mod/CMakeFiles/install.util


#############################################
# Utility command for install/local

build src/Mod/CMakeFiles/install/local.util: CUSTOM_COMMAND src/Mod/all
  COMMAND = cd /workspace/build/src/Mod && /usr/sbin/cmake -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake
  DESC = Installing only the local directory...
  pool = console
  restat = 1

build src/Mod/install/local: phony src/Mod/CMakeFiles/install/local.util


#############################################
# Utility command for install/strip

build src/Mod/CMakeFiles/install/strip.util: CUSTOM_COMMAND src/Mod/all
  COMMAND = cd /workspace/build/src/Mod && /usr/sbin/cmake -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake
  DESC = Installing the project stripped...
  pool = console
  restat = 1

build src/Mod/install/strip: phony src/Mod/CMakeFiles/install/strip.util

