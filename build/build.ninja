  COMMAND = cd /workspace/build/src/Mod/Sketcher/Gui && /usr/sbin/cmake --regenerate-during-build -S/workspace -B/workspace/build
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build src/Mod/Sketcher/Gui/rebuild_cache: phony src/Mod/Sketcher/Gui/CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build src/Mod/Sketcher/Gui/list_install_components: phony


#############################################
# Utility command for install

build src/Mod/Sketcher/Gui/CMakeFiles/install.util: CUSTOM_COMMAND src/Mod/Sketcher/Gui/all
  COMMAND = cd /workspace/build/src/Mod/Sketcher/Gui && /usr/sbin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build src/Mod/Sketcher/Gui/install: phony src/Mod/Sketcher/Gui/CMakeFiles/install.util


#############################################
# Utility command for install/local

build src/Mod/Sketcher/Gui/CMakeFiles/install/local.util: CUSTOM_COMMAND src/Mod/Sketcher/Gui/all
  COMMAND = cd /workspace/build/src/Mod/Sketcher/Gui && /usr/sbin/cmake -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake
  DESC = Installing only the local directory...
  pool = console
  restat = 1

build src/Mod/Sketcher/Gui/install/local: phony src/Mod/Sketcher/Gui/CMakeFiles/install/local.util


#############################################
# Utility command for install/strip

build src/Mod/Sketcher/Gui/CMakeFiles/install/strip.util: CUSTOM_COMMAND src/Mod/Sketcher/Gui/all
  COMMAND = cd /workspace/build/src/Mod/Sketcher/Gui && /usr/sbin/cmake -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake
  DESC = Installing the project stripped...
  pool = console
  restat = 1

build src/Mod/Sketcher/Gui/install/strip: phony src/Mod/Sketcher/Gui/CMakeFiles/install/strip.util


#############################################
# Utility command for SketcherGui_autogen_timestamp_deps

build src/Mod/Sketcher/Gui/SketcherGui_autogen_timestamp_deps: phony Mod/Part/PartGui.so Mod/Sketcher/Sketcher.so lib/libFreeCADGui.so


